# Create this file: Amdital-POC/.gitignore

# Dependencies
node_modules/
package-lock.json

# Build outputs
dist/
release/
out/

# Electron specific
screenshots/
screenshots-log.json

# Environment variables (keep .env.example, ignore actual .env)
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Temporary files
*.tmp
*.temp



# Ignore ONLY actual .env file if someone creates it
.env

# DO NOT ignore .env.development or .env.production or .env.example
!.env.development
!.env.production
!.env.example